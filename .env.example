# PromptPerfect Environment Variables
# Copy to .env.local and fill in real values.

# Default LLM provider (Gemini) — get your key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# Optional — Gemini model id (default: gemini-3.5-flash). Change if Google deprecates a model or you hit quotas.
# Quota fallback: gemini-3.5-flash-lite (separate free-tier budget, slightly weaker).
# GEMINI_MODEL=gemini-3.5-flash

# Supabase (auth, history, profiles, library)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Legacy aliases honored by the app (prefer the names above):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional LLM providers (user-supplied keys; leave blank to disable those providers)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here
# GOOGLE_API_KEY=your_gemini_key_here
# PROMPTPERFECT_GOOGLE_API_KEY=your_gemini_key_here
#
# If your shell exports its own OPENAI_API_KEY/OPENAI_BASE_URL (e.g. for a
# gateway like OpenRouter), use the PROMPTPERFECT_* names instead — they take
# precedence and keep the app pinned to the real providers:
# PROMPTPERFECT_OPENAI_API_KEY=your_openai_key_here
# PROMPTPERFECT_ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional — OpenAI model id (default: gpt-6-astra) and reasoning effort
# (low/medium/high/xhigh/max, default: high).
# OPENAI_MODEL=gpt-6-astra
# OPENAI_REASONING_EFFORT=high

# Optional — pin OpenAI/Anthropic API base URLs. Defaults point at the
# providers directly; set these only to route through a compatible gateway.
# (A global OPENAI_BASE_URL in your shell is deliberately ignored.)
# PROMPTPERFECT_OPENAI_BASE_URL=https://api.openai.com/v1
# PROMPTPERFECT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Required for correct OAuth + email-confirmation + password-reset redirects in production.
# No trailing slash. On Vercel, set this to your deployment URL (same value as Site URL in Supabase).
# Local dev: http://localhost:3000 (add these Redirect URLs in Supabase → Authentication → URL Configuration):
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/reset
# Password reset emails fail until /auth/reset is allowlisted and SUPABASE_SERVICE_ROLE_KEY is in .env.local
# Production: https://<your-domain>/auth/callback and https://<your-domain>/auth/reset
#
# Google OAuth (fixes "Error getting user profile from external provider"):
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# 2. Authorized redirect URI (required): https://<project-ref>.supabase.co/auth/v1/callback
# 3. Supabase Dashboard → Authentication → Google: paste Client ID + Client Secret, enable provider
# 4. OAuth consent screen: add test users while app is in "Testing" mode
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Comma-separated origins allowed to call `/api/optimize-sync` from the browser (CORS).
ALLOWED_ORIGINS=http://localhost:3000,https://promptperfect-beaglecorp.vercel.app

# Optional — only needed for local Supabase migrations
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Local-dev mode: disable ALL limitations (guest quota, limit modal/token bar,
# server rate limits) and run Supabase-backed features off localStorage.
# Unset or 'false' in production to restore product behaviour.
# NEXT_PUBLIC_UNLIMITED_MODE=true
# Server-side alias honored by API routes (first set wins with the public flag):
# UNLIMITED_MODE=true

# On Vercel, deploy previews set VERCEL_URL automatically; the app uses it as
# a fallback redirect host when NEXT_PUBLIC_SITE_URL is unset. No action needed.

# Local-dev override: raise the anonymous guest optimization limit (product default: 5).
# NEXT_PUBLIC_GUEST_TOKEN_LIMIT=50

# Key aliases honored by the app (first set wins):
#   Gemini:   PROMPTPERFECT_GOOGLE_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
#   OpenAI:   PROMPTPERFECT_OPENAI_API_KEY, OPENAI_API_KEY
#   Anthropic: PROMPTPERFECT_ANTHROPIC_API_KEY, ANTHROPIC_API_KEY
# The PROMPTPERFECT_* names take precedence on purpose: a global OPENAI_API_KEY /
# OPENAI_BASE_URL in your shell (e.g. pointing at OpenRouter) must never hijack the app.
